// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String?
  email    String  @unique
  password String
  role     role    @default(USER)

  review Review[]
}

enum role {
  USER
  ADMIN
}

model Product {
  id          Int      @id @default(autoincrement())
  productname String   @unique
  productcode String?
  synopsis    String?
  description String?
  details     String?
  price       Float?
  priceoff    Float?
  quanity     Int?
  images      String?
  category    Category @relation(fields: [categoryid], references: [id])
  categoryid  Int
  brand       Brand    @relation(fields: [brandid], references: [id])
  brandid     Int
  reviews     Review[]
}

model Brand {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  brandimage String
  products   Product[]
}

model Category {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  categoryimage String
  products      Product[]
}

model Review {
  id        Int     @id @default(autoincrement())
  rating    Int
  comment   String?
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
}

model Order {
  id Int @id @default(autoincrement())

  address         String
  postalcode      String
  phonenumber     String
  products        String
  price           String
  paymentcallback Boolean
  status          String
  authority       String
}

model General {
  id                     Int    @id @default(autoincrement())
  name                   String @unique
  description            String
  mainpageimage          String
  logoimage              String
  contactinfo            String
  productcartonloadimage String
}
